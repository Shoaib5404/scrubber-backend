/// Customer / public support inquiries (contact, demo, portal support).
model SupportTicket {
  id                      Int       @id @default(autoincrement())
  publicReference         String    @unique @map("public_reference") @db.VarChar(32)
  source                  String    @db.VarChar(16) // public | portal
  tenantId                Int?      @map("tenant_id")
  requesterUserId         Int?      @map("requester_user_id")
  requesterName           String    @map("requester_name") @db.VarChar(255)
  requesterEmail          String    @map("requester_email") @db.VarChar(255)
  requesterOrganization   String?   @map("requester_organization") @db.VarChar(255)
  category                String    @db.VarChar(64)
  subject                 String    @db.VarChar(255)
  description             String    @db.Text
  relatedBatchId          Int?      @map("related_batch_id")
  status                  String    @default("open") @db.VarChar(32)
  priority                String    @default("normal") @db.VarChar(16)
  emailNotifyStatus       String?   @map("email_notify_status") @db.VarChar(16) // sent | failed | skipped
  attachmentObjectKey     String?   @map("attachment_object_key") @db.VarChar(512)
  attachmentOriginalName  String?   @map("attachment_original_name") @db.VarChar(255)
  attachmentMimeType      String?   @map("attachment_mime_type") @db.VarChar(128)
  attachmentSizeBytes     Int?      @map("attachment_size_bytes")
  attachmentUploadedAt    DateTime? @map("attachment_uploaded_at")
  resolvedAt              DateTime? @map("resolved_at")
  closedAt                DateTime? @map("closed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  requester User?            @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([requesterEmail])
  @@index([tenantId, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id             Int      @id @default(autoincrement())
  ticketId       Int      @map("ticket_id")
  authorUserId   Int?     @map("author_user_id")
  authorType     String   @map("author_type") @db.VarChar(16) // customer | staff | system
  body           String   @db.Text
  isInternalNote Boolean  @default(false) @map("is_internal_note")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

