// Neo Scrubber — Prisma schema (scaffold)
// Full Laravel table mapping lands in Phase 2 (SP-2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so `prisma generate` succeeds before Phase 2 migrations.
model SchemaMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())
}
