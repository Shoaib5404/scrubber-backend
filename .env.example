NODE_ENV=development
PORT=3011
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
LOG_LEVEL=debug

DATABASE_URL=postgresql://scrubber:scrubber@localhost:5433/scrubber?schema=public&connection_limit=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6381
REDIS_TLS=false
# Lookup cache (Laravel redis.lookups / LOOKUP_CACHE_*)
REDIS_LOOKUP_DB=2
LOOKUP_CACHE_ENABLED=true
LOOKUP_CACHE_TTL=31536000
LOOKUP_CACHE_KEY_PREFIX=lookup
# Wave B Medicaid member ID formats (Laravel storage/app/data JSON; Nest local file)
MEDICAID_MEMBER_ID_FORMATS_PATH=storage/data/medicaid-member-id-formats.json

BULLMQ_CONCURRENCY=5
QUEUE_MODE=bullmq
USE_QUEUE=false
PARALLEL_VALIDATE=true
QUEUE_STALL_MINUTES=10
SCHEDULER_LOCK_TTL_MS=290000

JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=30
JWT_ISSUER=neo-scrubber
JWT_AUDIENCE=neo-scrubber-api
API_TOKEN_EXPIRATION_MINUTES=60

# MinIO / S3 (local Compose maps API→9020, console→9021)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
S3_ENDPOINT=http://localhost:9020
S3_BUCKET=neo-scrubber
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
EDI_MAX_BYTES=26214400
EDI_LOCAL_PATH=./storage/edi
EDI837_SPEC_PATH=./edi/837p/models
EDI837_VALIDATION_ENABLED=true
EDI837_VALIDATION_STRICT=true
NCCI_CLAIM_CPT_DB_THRESHOLD=48
SCRUBBER_RULE_SWITCH_ENM_ONE_DAY_EARLIER=true
SCRUBBER_RULE_SWITCH_EM_BUNDLING=true

FRONTEND_URL=http://localhost:3010
