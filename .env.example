NODE_ENV=development
PORT=3011
CORS_ORIGINS=http://localhost:3010
LOG_LEVEL=debug

DATABASE_URL=postgresql://scrubber:scrubber@localhost:5433/scrubber?schema=public&connection_limit=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6381
REDIS_TLS=false

BULLMQ_CONCURRENCY=5
QUEUE_MODE=bullmq

JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=30
JWT_ISSUER=neo-scrubber
JWT_AUDIENCE=neo-scrubber-api
API_TOKEN_EXPIRATION_MINUTES=60

# MinIO / S3 (local Compose maps API→9020, console→9021)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
S3_ENDPOINT=http://localhost:9020
S3_BUCKET=neo-scrubber
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
EDI_MAX_BYTES=26214400
EDI_LOCAL_PATH=./storage/edi

FRONTEND_URL=http://localhost:3010
