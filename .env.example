NODE_ENV=development
PORT=3011
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
LOG_LEVEL=debug

DATABASE_URL=postgresql://scrubber:scrubber@localhost:5433/scrubber?schema=public&connection_limit=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6381
REDIS_TLS=false
# Lookup/reference cache on Redis logical DB 1 (BullMQ/locks use REDIS_URL DB 0).
# Set LOOKUP_CACHE_ENABLED=false to force PostgreSQL-only reads (fail-open path always on).
REDIS_LOOKUP_DB=1
LOOKUP_CACHE_ENABLED=true
LOOKUP_CACHE_TTL=31536000
LOOKUP_CACHE_KEY_PREFIX=lookup
# Max bytes per Redis STRING; larger JSON is stored as __meta + __chunk:N (never skipped).
LOOKUP_CACHE_CHUNK_BYTES=1048576
# After library import: invalidate then warm Redis (false = invalidate only).
LOOKUP_CACHE_WARM_ON_IMPORT=true
# Medicaid member ID formats JSON (Nest local file under storage/data)
MEDICAID_MEMBER_ID_FORMATS_PATH=storage/data/medicaid-member-id-formats.json

BULLMQ_CONCURRENCY=5
QUEUE_MODE=bullmq
USE_QUEUE=false
PARALLEL_VALIDATE=true
QUEUE_STALL_MINUTES=10
SCHEDULER_LOCK_TTL_MS=290000

JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32
# Access JWT lifetime in minutes (frontend auto-refreshes on 401).
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=30
JWT_ISSUER=neo-scrubber
JWT_AUDIENCE=neo-scrubber-api
API_TOKEN_EXPIRATION_MINUTES=60

# EDI object storage: local disk (default) or s3 (MinIO / AWS).
# Presigned browser uploads (POST /batches/upload-url) require STORAGE_DRIVER=s3.
STORAGE_DRIVER=s3
# MinIO / S3 — used when STORAGE_DRIVER=s3.
# Local Compose ports (active): API 9020→9000, console 9021→9001.
# Production Compose ports (uncomment in docker-compose.yml): API 9000, console 9001.
# Bucket is auto-created on API boot when STORAGE_DRIVER=s3 (no manual mc mb required).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
# Nest server ↔ MinIO (host when API runs on host; use http://minio:9000 if Nest is in Compose).
S3_ENDPOINT=http://localhost:9020
# Browser-facing endpoint for presigned PUT/GET (must be reachable from the browser).
# Local: same as S3_ENDPOINT (http://localhost:9020). Prod: public host :9000 or HTTPS URL.
S3_PUBLIC_ENDPOINT=http://localhost:9020
S3_BUCKET=neo-scrubber
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=900
EDI_MAX_BYTES=10485760
EDI_LOCAL_PATH=./storage/edi
EDI837_SPEC_PATH=./edi/837p/models
EDI837_VALIDATION_ENABLED=true
EDI837_VALIDATION_STRICT=true
NCCI_CLAIM_CPT_DB_THRESHOLD=48
SCRUBBER_RULE_SWITCH_ENM_ONE_DAY_EARLIER=true
SCRUBBER_RULE_SWITCH_EM_BUNDLING=true

# CMS/NPI Order and Referring sync (SP-8 Task 20)
NPI_ORDERING_REFERRING_IMPORT_DIRECTORY=import/NPI_Ordering_Referring
NPI_ORDERING_REFERRING_MAX_LOCAL_CSV_FILES=2
NPI_ORDERING_REFERRING_DOWNLOAD_TIMEOUT_SECONDS=600
NPI_ORDERING_REFERRING_CMS_DATASET_TYPE_ID=c99b5865-1119-4436-bb80-c5af2773ea1f
NPI_ORDERING_REFERRING_DOWNLOAD_REQUEST_ATTEMPTS=30
NPI_ORDERING_REFERRING_DOWNLOAD_REQUEST_POLL_SECONDS=2
# Daily 06:00 America/New_York npi-ordering-referrings:sync via SchedulerHost.
# Default false. Set true + run `npm run start:scheduler`.
NPI_SYNC_SCHEDULE_ENABLED=false

FRONTEND_URL=http://localhost:3010
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_REQUIRED=false
PASSWORD_CONFIRM_TTL_SECONDS=900

# Transactional email (invites, password reset, verification).
# Order: SendGrid (if both key + from set) → Resend (if both key + from set) → fail with
# "Email not sent due to …". Uncomment and fill SendGrid to use it instead of Resend.
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM_EMAIL=noreply@your-verified-domain.com
# SENDGRID_FROM_NAME=Scrubber
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=Scrubber
# Resend free/test mode only allows the account owner — redirect all Resend mail here.
# RESEND_SANDBOX_TO=you@your-resend-account-email.com
MAIL_FROM_NAME=Scrubber
MAIL_FROM=noreply@neoscrubber.local
TENANT_INVITE_TTL_DAYS=7
