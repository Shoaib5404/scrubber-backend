          "n405": {
            "x12_id": "309",
            "name": "location_qualifier",
            "required": false,
            "not_used": true
          },
          "n406": {
            "x12_id": "310",
            "name": "location_identifier",
            "required": false,
            "not_used": true
          },
          "n407": {
            "x12_id": "1715",
            "name": "country_subdivision_code",
            "required": false,
            "conditional": "Required when the address is not in the US/territories or Canada, and the country in N404 has administrative subdivisions. If not required by this implementation guide, do not send.",
            "min_length": 1,
            "max_length": 3,
            "description": "Country subdivision code"
          }
        }
      },
      "REF_EI": {
        "name": "Billing Provider Tax Identification",
        "required": true,
        "repeatable": false,
        "position": 4,
        "syntax_rules": [
          {"code": "R0203", "at_least_one_of": ["ref02", "ref03"]}
        ],
        "elements": {
          "ref01": {
            "x12_id": "128",
            "name": "reference_identification_qualifier",
