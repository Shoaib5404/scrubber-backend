            "min_length": 2,
            "max_length": 2,
            "description": "State or province code"
          },
          "n403": {
            "x12_id": "116",
            "name": "billing_provider_postal_zone_or_zip_code",
            "required": false,
            "conditional": "Required when the address is in the US/territories or Canada, or when a postal code exists for the country in N404. For US addresses, the full nine-digit ZIP code must be provided. If not required by this implementation guide, do not send.",
