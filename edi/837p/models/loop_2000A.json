            "max_length": 55,
            "description": "Street address line 2"
          }
        }
      },
      "N4": {
        "name": "Billing Provider City, State, ZIP Code",
        "required": true,
        "repeatable": false,
        "position": 3,
        "syntax_rules": [
          {"code": "E0207", "mutually_exclusive": ["n402", "n407"]},
          {"code": "C0605", "if": "n406", "then_required": ["n405"]},
          {"code": "C0704", "if": "n407", "then_required": ["n404"]}
