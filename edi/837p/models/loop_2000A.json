            "max_length": 15,
            "description": "Postal zone or ZIP code"
          },
          "n404": {
            "x12_id": "26",
            "name": "country_code",
            "required": false,
            "conditional": "Required when the address is outside the United States of America. If not required by this implementation guide, do not send.",
            "min_length": 2,
            "max_length": 3,
            "description": "ISO 3166 alpha-2 country code"
