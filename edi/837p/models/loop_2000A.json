          "per07": {
            "x12_id": "365",
            "name": "communication_number_qualifier_3",
            "required": false,
            "conditional": "Required when this information is deemed necessary by the submitter. If not required by this implementation guide, do not send.",
            "min_length": 2,
            "max_length": 2,
            "valid_values": ["EM", "EX", "FX", "TE"],
            "description": "Third qualifier; paired with PER08 via syntax_rules P0708"
          },
