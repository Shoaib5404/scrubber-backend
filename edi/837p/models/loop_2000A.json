          "ref02": {
            "x12_id": "127",
            "name": "billing_provider_tax_identification_number",
            "required": true,
            "format": "NUMERIC",
            "min_length": 9,
            "max_length": 9,
            "description": "Exactly 9 digits, no separators"
          },
          "ref03": {
            "x12_id": "352",
            "name": "description",
            "required": false,
            "not_used": true
          },
          "ref04": {
            "x12_id": "C040",
            "name": "reference_identifier",
            "required": false,
            "not_used": true
          }
        }
      },
      "REF_LU": {
        "name": "Billing Provider UPIN/License Information",
        "required": false,
        "repeatable": true,
        "max_occurs": 2,
        "position": 5,
        "conditional": "Required prior to the mandated NPI date when a UPIN and/or license number is necessary for the receiver to identify the provider; OR on/after NPI date when NM109 of this loop is not used and a UPIN or license is necessary. If not required by this implementation guide, do not send.",
        "syntax_rules": [
          {"code": "R0203", "at_least_one_of": ["ref02", "ref03"]}
        ],
        "elements": {
          "ref01": {
            "x12_id": "128",
            "name": "reference_identification_qualifier",
            "required": true,
            "min_length": 2,
