            "max_length": 60,
            "description": "Organization name or last name"
          },
          "nm104": {
            "x12_id": "1036",
            "name": "billing_provider_first_name",
            "required": false,
            "conditional": "Required when NM102=1 (person) and the person has a first name. If not required by this implementation guide, do not send.",
            "only_when": {"element": "nm102", "equals": "1"},
            "min_length": 1,
            "max_length": 35,
            "description": "First name when NM102=1"
          },
          "nm105": {
            "x12_id": "1037",
            "name": "billing_provider_middle_name",
            "required": false,
            "conditional": "Required when NM102=1 (person) and the middle name or initial of the person is needed to identify the individual. If not required by this implementation guide, do not send.",
            "only_when": {"element": "nm102", "equals": "1"},
            "min_length": 1,
            "max_length": 25,
            "description": "Middle name or initial"
          },
          "nm106": {
            "x12_id": "1038",
            "name": "name_prefix",
            "required": false,
            "not_used": true
          },
          "nm107": {
            "x12_id": "1039",
            "name": "billing_provider_name_suffix",
            "required": false,
            "conditional": "Required when NM102=1 (person) and the name suffix of the person is needed to identify the individual. If not required by this implementation guide, do not send.",
            "only_when": {"element": "nm102", "equals": "1"},
            "min_length": 1,
            "max_length": 10,
            "description": "Billing Provider Name Suffix"
          },
          "nm108": {
            "x12_id": "66",
            "name": "identification_code_qualifier",
            "required": false,
            "conditional": "Required for providers in the US/territories on/after NPI date when eligible for NPI; OR non-US when NPI received; OR prior to NPI date when NPI received and submitter can send it. If not required by this implementation guide, do not send.",
            "min_length": 1,
            "max_length": 2,
            "valid_values": ["XX"],
            "description": "XX=NPI (situational per X222); paired with NM109 via syntax_rules P0809"
          },
          "nm109": {
            "x12_id": "67",
            "name": "billing_provider_identifier",
            "required": false,
            "conditional": "Required under the same situational rules as NM108. If not required by this implementation guide, do not send.",
            "min_length": 2,
            "max_length": 80,
            "description": "Billing Provider Identifier (NPI when NM108=XX); paired with NM108 via syntax_rules P0809"
          },
          "nm110": {
            "x12_id": "706",
            "name": "entity_relationship_code",
            "required": false,
            "not_used": true
          },
          "nm111": {
            "x12_id": "98",
            "name": "entity_identifier_code",
            "required": false,
            "not_used": true
          },
          "nm112": {
            "x12_id": "1035",
            "name": "name_last_or_organization_name",
            "required": false,
            "not_used": true
          }
        }
      },
      "N3": {
        "name": "Billing Provider Address",
