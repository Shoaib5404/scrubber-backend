    "child_loops": ["loop_2010AA", "loop_2010AB", "loop_2010AC"],
    "validation_rules": [
      {"rule": "HL01 is X12 AN 1/12; 837P content must be numeric characters only; sequential starting at 1 within ST-SE"},
      {"rule": "HL02 is not used for every 2000A HL (billing provider is top of hierarchy)"},
      {"rule": "PRV is situational: required when taxonomy impacts adjudication; otherwise do not send"},
      {"rule": "PRV P0203: if either PRV02 or PRV03 is present, the other is required"},
      {"rule": "PRV04, PRV05, and PRV06 are not used"},
      {"rule": "CUR is situational: required when amounts are not USD; otherwise do not send (USD default)"},
      {"rule": "CUR03 through CUR21 are not used in 837P; X12 syntax C0807-C2119 still enforced if those elements appear"}
    ]
  },
  "loop_2010AA": {
    "name": "Billing Provider Name",
    "required": true,
    "repeatable": false,
    "max_occurs": 1,
    "parent": "loop_2000A",
    "segments": {
      "NM1": {
        "name": "Billing Provider Name",
        "required": true,
        "repeatable": false,
        "position": 1,
        "syntax_rules": [
          {"code": "P0809", "if": "nm108", "then_required": ["nm109"]},
          {"code": "P0809", "if": "nm109", "then_required": ["nm108"]},
          {"code": "C1110", "if": "nm111", "then_required": ["nm110"]},
          {"code": "C1203", "if": "nm112", "then_required": ["nm103"]}
        ],
        "elements": {
          "nm101": {
            "x12_id": "98",
            "name": "entity_identifier_code",
            "required": true,
            "min_length": 2,
            "max_length": 3,
            "valid_values": ["85"],
            "description": "85=Billing Provider"
          },
          "nm102": {
            "x12_id": "1065",
            "name": "entity_type_qualifier",
            "required": true,
            "min_length": 1,
            "max_length": 1,
            "valid_values": ["1", "2"],
            "description": "1=Person, 2=Non-Person Entity"
          },
          "nm103": {
            "x12_id": "1035",
            "name": "billing_provider_last_or_organization_name",
            "required": true,
