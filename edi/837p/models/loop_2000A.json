    "validation_rules": [
      {"rule": "NM104/NM105/NM107 situational when NM102=1; otherwise do not send"},
      {"rule": "NM108/NM109 situational per NPI rules; P0809 pair; XX when qualifier present"},
      {"rule": "NM110-NM112 not used"},
      {"rule": "N302 situational second address line; otherwise do not send"},
      {"rule": "N4 E0207/C0605/C0704; N405-N406 not used; US ZIP nine digits per X222"},
      {"rule": "REF tax required; REF02 exactly 9 digits; R0203; REF03-REF04 not used"},
      {"rule": "REF UPIN/license situational max 2; R0203; REF03-REF04 not used"},
      {"rule": "PER situational vs 1000A; PER02 required on first iteration; P0304/P0506/P0708; PER09 not used"}
    ]
  },
  "loop_2010AB": {
    "name": "Pay-to Address Name",
