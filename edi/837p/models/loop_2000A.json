{
  "loop_2000A": {
    "name": "Billing Provider Hierarchical Level",
    "required": true,
    "repeatable": true,
    "max_occurs": 999999,
    "parent": "ST",
    "segments": {
      "HL": {
        "name": "Billing Provider Hierarchical Level",
        "required": true,
        "repeatable": false,
        "position": 1,
        "elements": {
          "hl01": {
            "x12_id": "628",
            "name": "hierarchical_id_number",
            "required": true,
            "data_type": "AN",
            "format": "NUMERIC",
            "min_length": 1,
            "max_length": 12,
            "description": "Hierarchical ID Number (X12 AN 1/12). 837P content: numeric characters only. First HL in ST-SE must be 1, then increment by 1 (e.g. 1, 2, 3, 10, 11)."
          },
          "hl02": {
            "x12_id": "734",
            "name": "hierarchical_parent_id_number",
            "required": false,
            "not_used": true,
            "description": "Not used for 2000A (top of hierarchy)"
          },
          "hl03": {
            "x12_id": "735",
            "name": "hierarchical_level_code",
            "required": true,
            "min_length": 1,
            "max_length": 2,
            "valid_values": ["20"],
            "description": "20=Information Source (Billing Provider)"
          },
          "hl04": {
            "x12_id": "736",
            "name": "hierarchical_child_code",
            "required": true,
            "min_length": 1,
            "max_length": 1,
            "valid_values": ["1"],
            "description": "1=Additional Subordinate HL Exists"
          }
        }
      },
      "PRV": {
        "name": "Billing Provider Specialty Information",
        "required": false,
        "repeatable": false,
        "position": 2,
        "conditional": "Required when the payer's adjudication is known to be impacted by the provider taxonomy code. If not required by this implementation guide, do not send.",
        "elements": {
          "prv01": {
            "x12_id": "1221",
            "name": "provider_code",
            "required": true,
            "min_length": 1,
            "max_length": 3,
            "valid_values": ["BI"],
            "description": "BI=Billing"
          },
          "prv02": {
            "x12_id": "128",
            "name": "reference_identification_qualifier",
            "required": true,
            "required_with": "prv03",
            "min_length": 2,
            "max_length": 3,
            "valid_values": ["PXC"],
            "description": "PXC=Health Care Provider Taxonomy Code (X12 syntax P0203 with PRV03)"
          },
          "prv03": {
            "x12_id": "127",
            "name": "provider_taxonomy_code",
            "required": true,
            "required_with": "prv02",
            "min_length": 1,
            "max_length": 50,
            "description": "Provider Taxonomy Code (code source 682); X12 AN 1/50"
          },
          "prv04": {
            "x12_id": "156",
            "name": "state_or_province_code",
            "required": false,
            "not_used": true
          },
          "prv05": {
            "x12_id": "C035",
            "name": "provider_specialty_information",
            "required": false,
            "not_used": true
          },
          "prv06": {
            "x12_id": "1223",
            "name": "provider_organization_code",
            "required": false,
            "not_used": true
          }
        }
      },
      "CUR": {
        "name": "Foreign Currency Information",
        "required": false,
        "repeatable": false,
        "position": 3,
        "conditional": "Required when the amounts represented in this transaction are currencies other than the United States dollar. If not required by this implementation guide, do not send. If CUR is not used, all amounts must be expressed in US dollars.",
        "syntax_rules": [
          {"code": "C0807", "if": "cur08", "then_required": ["cur07"]},
          {"code": "C0907", "if": "cur09", "then_required": ["cur07"]},
          {"code": "L101112", "if": "cur10", "then_any_of": ["cur11", "cur12"]},
          {"code": "C1110", "if": "cur11", "then_required": ["cur10"]},
          {"code": "C1210", "if": "cur12", "then_required": ["cur10"]},
          {"code": "L131415", "if": "cur13", "then_any_of": ["cur14", "cur15"]},
          {"code": "C1413", "if": "cur14", "then_required": ["cur13"]},
          {"code": "C1513", "if": "cur15", "then_required": ["cur13"]},
          {"code": "L161718", "if": "cur16", "then_any_of": ["cur17", "cur18"]},
          {"code": "C1716", "if": "cur17", "then_required": ["cur16"]},
          {"code": "C1816", "if": "cur18", "then_required": ["cur16"]},
          {"code": "L192021", "if": "cur19", "then_any_of": ["cur20", "cur21"]},
          {"code": "C2019", "if": "cur20", "then_required": ["cur19"]},
          {"code": "C2119", "if": "cur21", "then_required": ["cur19"]}
