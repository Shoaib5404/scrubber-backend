          "per04": {
            "x12_id": "364",
            "name": "communication_number_1",
            "required": true,
            "min_length": 1,
            "max_length": 256,
            "description": "Phone, fax, or email"
          },
          "per05": {
            "x12_id": "365",
            "name": "communication_number_qualifier_2",
            "required": false,
            "conditional": "Required when this information is deemed necessary by the submitter. If not required by this implementation guide, do not send.",
            "min_length": 2,
            "max_length": 2,
            "valid_values": ["EM", "EX", "FX", "TE"],
            "description": "EX=Extension; paired with PER06 via syntax_rules P0506"
          },
          "per06": {
            "x12_id": "364",
            "name": "communication_number_2",
            "required": false,
            "conditional": "Required if PER05 present (X12 syntax P0506)",
            "min_length": 1,
            "max_length": 256,
            "description": "Second contact method; paired with PER05 via syntax_rules P0506"
          },
          "per07": {
            "x12_id": "365",
            "name": "communication_number_qualifier_3",
            "required": false,
            "conditional": "Required when this information is deemed necessary by the submitter. If not required by this implementation guide, do not send.",
            "min_length": 2,
            "max_length": 2,
            "valid_values": ["EM", "EX", "FX", "TE"],
            "description": "Third contact qualifier; paired with PER08 via syntax_rules P0708"
          },
          "per08": {
            "x12_id": "364",
            "name": "communication_number_3",
            "required": false,
            "conditional": "Required if PER07 present (X12 syntax P0708)",
            "min_length": 1,
            "max_length": 256,
            "description": "Third contact method; paired with PER07 via syntax_rules P0708"
          },
          "per09": {
            "x12_id": "443",
            "name": "contact_inquiry_reference",
            "required": false,
            "not_used": true
          }
        }
      }
    },
    "validation_rules": [
      {"rule": "NM103 required regardless of entity type"},
      {"rule": "NM104 required when NM102=1 (person) and the person has a first name; otherwise do not send"},
      {"rule": "NM105 required when NM102=1 (person) and the middle name or initial is needed to identify the individual; otherwise do not send"},
      {"rule": "NM106, NM107, NM110-NM112 not used; value present = error, empty = OK"},
      {"rule": "PER02 required when contact name differs from Submitter NM1 AND it is the first PER iteration; otherwise do not send"},
      {"rule": "PER05 and PER07 required when deemed necessary by the submitter; otherwise do not send"},
      {"rule": "PER09 not used; PER syntax P0304/P0506/P0708"}
    ]
  },
