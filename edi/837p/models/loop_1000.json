          },
          "nm109": {
            "x12_id": "67",
            "name": "submitter_identifier",
            "required": true,
            "min_length": 2,
            "max_length": 80,
            "description": "Submitter ETIN assigned by payer; paired with NM108 via syntax_rules P0809"
          },
          "nm110": {
            "x12_id": "706",
            "name": "entity_relationship_code",
            "required": false,
            "not_used": true
