          "nm111": {
            "x12_id": "98",
            "name": "entity_identifier_code",
            "required": false,
            "not_used": true
          },
          "nm112": {
            "x12_id": "1035",
            "name": "name_last_or_organization_name",
            "required": false,
            "not_used": true
