          "nm104": {
            "x12_id": "1036",
            "name": "submitter_first_name",
            "required": false,
            "conditional": "Required when NM102=1 (person) and the person has a first name. If not required by this implementation guide, do not send.",
            "only_when": {"element": "nm102", "equals": "1"},
            "min_length": 1,
            "max_length": 35,
            "description": "First name when NM102=1"
          },
          "nm105": {
            "x12_id": "1037",
